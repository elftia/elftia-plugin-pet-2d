{
  "name": "pet-2d",
  "version": "0.2.6",
  "minElftiaVersion": "0.2.8",
  "kind": "app-extension",
  "capabilities": {
    "optional": [
      {
        "id": "elftia.quick-chat",
        "range": "^1.0.0",
        "target": "main"
      }
    ]
  },
  "displayName": "2D Desktop Pet",
  "description": "A 2D desktop pet for Elftia: host activity facts drive a frozen 8-state grammar, rendered from machine-checkable character packs. Reference implementation of the desktop-pet character-pack contract. v0.2 adds the main-window manager page (rail destination).",
  "contributes": {
    "pet": {
      "entry": "pet.mjs",
      "execution": "opaque-frame-v1",
      "requiredMajor": 1,
      "requiredMinor": 52,
      "builtAgainst": "1.54.0"
    },
    "renderer": {
      "entry": "manager.mjs",
      "execution": "opaque-frame-v1",
      "requiredMajor": 1,
      "requiredMinor": 54,
      "builtAgainst": "1.54.0"
    },
    "main": {
      "entry": "index.cjs",
      "requiredMajor": 1,
      "requiredMinor": 35,
      "builtAgainst": "1.54.0"
    }
  },
  "permissions": [
    "host:storage",
    "host:native-dialog",
    "node:fs"
  ]
}
