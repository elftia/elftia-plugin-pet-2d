{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // .tsx support for the manager page (src/manager/page.tsx): the
    // automatic runtime emits `react/jsx-runtime` imports, which the
    // manager vite pass marks external (host import map) — mirroring the
    // DS renderer setup.
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    // NO `paths` (OQ6, settled): `@elftia/plugin-types` resolves as an
    // ordinary devDependency out of this repo's OWN node_modules. It used to
    // be mapped at a sibling host worktree's source tree, which made the
    // producer un-buildable anywhere that checkout was absent (it WAS absent
    // — every `@elftia/plugin-types` import was a TS2307). The contract now
    // arrives as a normal package, so a third-party pack author gets the same
    // resolution the maintainers do. `@elftia/agent-spec` (plugin-types' peer,
    // referenced only transitively from its .d.ts) is declared for the same
    // reason. Both resolve from the public npm registry.
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "vite.plugin.config.ts",
    "vite.plugin.manager.config.ts",
    "vite.plugin.main.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "node_modules", "fixtures", "packs-src"]
}
